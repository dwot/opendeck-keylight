{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "me.dwot.keylight",
	"Name": "Key Light Direct",
	"Version": "0.5.3.0",
	"Author": "dwot",
	"Description": "Control Elgato Key Light devices directly over the network (auto-discovered via mDNS). Supports Stream Deck+ dials. Tested on Linux; untested on Windows and macOS.",
	"Category": "Key Light Direct",
	"CategoryIcon": "icons/category",
	"Icon": "icons/plugin",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"UUID": "me.dwot.keylight.brightnessdial",
			"Name": "Brightness Dial",
			"Tooltip": "Stream Deck+: rotate to adjust brightness; press and tap are configurable (on/off, switch to colour temperature, reset temperature).",
			"Icon": "icons/brightness-dial",
			"PropertyInspectorPath": "propertyInspector/brightnessdial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/dial.json",
				"TriggerDescription": {
					"Rotate": "Adjust brightness",
					"Push": "Configurable",
					"Touch": "Configurable"
				}
			},
			"States": [
				{
					"Image": "icons/brightness-dial",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "me.dwot.keylight.temperaturedial",
			"Name": "Temperature Dial",
			"Tooltip": "Stream Deck+: rotate to adjust colour temperature; press and tap are configurable (on/off, switch to brightness, reset temperature).",
			"Icon": "icons/temperature-dial",
			"PropertyInspectorPath": "propertyInspector/temperaturedial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/dial.json",
				"TriggerDescription": {
					"Rotate": "Adjust temperature",
					"Push": "Configurable",
					"Touch": "Configurable"
				}
			},
			"States": [
				{
					"Image": "icons/temperature-dial",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "me.dwot.keylight.toggle",
			"Name": "Toggle Light",
			"Tooltip": "Toggle a Key Light on/off.",
			"Icon": "icons/toggle",
			"PropertyInspectorPath": "propertyInspector/toggle.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "icons/toggle",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "me.dwot.keylight.setbrightness",
			"Name": "Set Brightness",
			"Tooltip": "Set a Key Light to a specific brightness.",
			"Icon": "icons/brightness",
			"PropertyInspectorPath": "propertyInspector/setbrightness.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "icons/brightness",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "me.dwot.keylight.scene",
			"Name": "Apply Scene",
			"Tooltip": "Apply a preset (on/off + brightness + temperature).",
			"Icon": "icons/scene",
			"PropertyInspectorPath": "propertyInspector/scene.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "icons/scene",
					"TitleAlignment": "bottom"
				}
			]
		}
	]
}
